# Extend the Django base already approved by the Programador operator.
# Pass a reference pinned to an immutable digest as STUDIO_DJANGO_BASE.
ARG STUDIO_DJANGO_BASE
FROM golang:1.27.3 AS gno-build
RUN git clone --depth 1 --branch v1.8.0 https://github.com/gnolang/gno.git /opt/gno \
 && cd /opt/gno \
 && test "$(git rev-parse HEAD)" = fc79041f4cd1a7b3ed4b316dc5ac14162eb78730 \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /usr/local/bin/gno ./gnovm/cmd/gno \
 && CGO_ENABLED=0 go build -o /usr/local/bin/gnokey ./gno.land/cmd/gnokey
COPY tools/sourceparser/main.go /tmp/sourceparser.go
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /usr/local/bin/realmproof-source-parser /tmp/sourceparser.go

FROM ${STUDIO_DJANGO_BASE}
ENV GNOROOT=/opt/gno
COPY --from=gno-build /usr/local/bin/gno /usr/local/bin/gno
COPY --from=gno-build /usr/local/bin/gnokey /usr/local/bin/gnokey
COPY --from=gno-build /usr/local/bin/realmproof-source-parser /usr/local/bin/realmproof-source-parser
COPY --from=gno-build /opt/gno/LICENSE.md /opt/gno/LICENSE.md
COPY --from=gno-build /opt/gno/gnovm/stdlibs /opt/gno/gnovm/stdlibs
COPY --from=gno-build /opt/gno/gnovm/tests/stdlibs /opt/gno/gnovm/tests/stdlibs
